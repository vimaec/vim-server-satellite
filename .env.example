# Copy to .env.local and edit as needed. All values have working defaults,
# so the app runs against the dev server with no .env file at all.

# VIM Server base URL (no trailing slash).
VITE_VIM_SERVER_URL=https://server-dev.vimaec.com

# Microsoft Entra ID app registration. Used only as a fallback: at startup the
# app asks GET {server}/api/v1/config for the ids the server itself signs in with.
VITE_ENTRA_TENANT_ID=4e856586-7c87-4498-956e-ab21660251e1
VITE_ENTRA_CLIENT_ID=f518716e-50bb-4c82-bbee-3c85da317f82

# Delegated scope exposed by the app registration. Defaults to
# api://<clientId>/Sync.ReadWrite when left unset.
# VITE_ENTRA_API_SCOPE=api://f518716e-50bb-4c82-bbee-3c85da317f82/Sync.ReadWrite
